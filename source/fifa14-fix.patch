+bool Rasterizer::BeginOcclusionQuery() {
+    if (occlusion_begin_queries.empty() || !instance.IsHostQueryResetSupported()) {
+        return false;
+    }
+    const u32 pool_index = (next_occlusion_query / OcclusionQueriesPerPool) % NumOcclusionPools;
+    const u32 query = next_occlusion_query % OcclusionQueriesPerPool;
+    auto& pool = occlusion_pools[pool_index];
+    if (query == 0) {
+        const auto device = instance.GetDevice();
+        if (!pool) {
+            pool = Check<"create occlusion query pool">(device.createQueryPoolUnique({
+                .queryType = vk::QueryType::eOcclusion,
+                .queryCount = OcclusionQueriesPerPool,
+            }));
+        } else {
+            scheduler.Wait(occlusion_pool_ticks[pool_index]);
+        }
+        device.resetQueryPool(*pool, 0, OcclusionQueriesPerPool);
+    }
+    occlusion_pool_ticks[pool_index] = scheduler.CurrentTick();
+    const auto flags = instance.IsOcclusionQueryPreciseSupported()
+                           ? vk::QueryControlFlagBits::ePrecise
+                           : vk::QueryControlFlags{};
+    scheduler.CommandBuffer().beginQuery(*pool, query, flags);
+    return true;
+}
+
+void Rasterizer::EndOcclusionQuery() {
+    const u32 pool_index = (next_occlusion_query / OcclusionQueriesPerPool) % NumOcclusionPools;
+    const u32 query = next_occlusion_query % OcclusionQueriesPerPool;
+    scheduler.CommandBuffer().endQuery(*occlusion_pools[pool_index], query);
+    ++next_occlusion_query;
+}
+
+void Rasterizer::DumpOcclusionCounters(VAddr address, u32 num_counter_pairs) {
+    // Each counter pair is a begin and an end sample count; a dump to an end slot follows the
+    // dump to its begin slot, one u64 earlier.
+    static constexpr u64 CounterValid = 1ULL << 63;
+    static constexpr u32 CounterPairSize = 2 * sizeof(u64);
+    auto* counters = reinterpret_cast<u64*>(address);
+    const bool is_begin = address % CounterPairSize == 0;
+    for (u32 i = is_begin ? 0 : 1; i < num_counter_pairs; ++i) {
+        counters[i * 2] = CounterValid;
+    }
+    if (is_begin) {
+        occlusion_begin_queries[address] = next_occlusion_query;
+        return;
+    }
+
+    const auto it = occlusion_begin_queries.find(address - sizeof(u64));
+    if (it == occlusion_begin_queries.end() || it->second == next_occlusion_query) {
+        if (it != occlusion_begin_queries.end()) {
+            occlusion_begin_queries.erase(it);
+        }
+        counters[0] = CounterValid;
+        return;
+    }
+    const u32 first_query = it->second;
+    const u32 last_query = next_occlusion_query;
+    occlusion_begin_queries.erase(it);
+
+    // Keep the previous result readable until the new one is resolved.
+    counters[0] |= CounterValid;
+    scheduler.DeferPriorityOperation([this, counters, first_query, last_query] {
+        u64 samples = 0;
+        for (u32 q = first_query; q < last_query; ++q) {
+            const u32 pool_index = (q / OcclusionQueriesPerPool) % NumOcclusionPools;
+            u64 value = 0;
+            const auto result = instance.GetDevice().getQueryPoolResults(
+                *occlusion_pools[pool_index], q % OcclusionQueriesPerPool, 1, sizeof(value),
+                &value, sizeof(value),
+                vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWait);
+            if (result == vk::Result::eSuccess) {
+                samples += value;
+            }
+        }
+        counters[0] = samples | CounterValid;
+    });
+}
